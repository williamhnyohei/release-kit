{
  "name": "@williamhnyohei/release-kit",
  "version": "0.2.0",
  "description": "AI-friendly GitHub release kit: agents set semver labels, Actions auto-merge/tag/release",
  "type": "module",
  "bin": {
    "release-kit": "./bin/release-kit.js"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "templates",
    ".github/workflows"
  ],
  "scripts": {
    "start": "node bin/release-kit.js",
    "test": "node --test src/*.test.js scripts/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "github-actions",
    "semver",
    "release",
    "automerge",
    "ci"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamhnyohei/release-kit.git"
  }
}
